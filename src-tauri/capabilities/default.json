{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "opener:default",
    "dialog:default",
    "core:window:allow-set-min-size",
    "core:window:allow-current-monitor"
  ]
}
